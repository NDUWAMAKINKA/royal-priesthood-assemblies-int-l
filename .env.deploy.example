# Copy to .env.deploy (gitignored) and fill in what you need.
#
# A normal deploy works with none of these: the repo is detected from the
# origin remote, and one push rebuilds the website on GitHub Pages plus the API
# on Render. The values below only change how deploy.py checks or rebuilds.

# Optional. Defaults to the origin remote if it is on github.com.
# GITHUB_REPO=NDUWAMAKINKA/royal-priesthood-assemblies-int-l

# Optional. Anonymous GitHub API calls are limited to 60 per hour; a token
# raises that limit. Create a read-only token with no scopes.
# GITHUB_TOKEN=

# The API health endpoint (must include /api/health).
API_HEALTH_URL=https://rpai-give-api.onrender.com/api/health

# Only needed if the website moves from GitHub Pages to the Render static
# site. When set, deploy.py checks https://.../deploy-info.json instead of the
# GitHub Pages build.
# SITE_URL=https://rpai-church-site.onrender.com

# Optional. Render -> service -> Settings -> Deploy Hook.
# Only used by:  python scripts/deploy.py --redeploy frontend
RENDER_DEPLOY_HOOK_FRONTEND=

# Optional. Render -> rpai-give-api -> Settings -> Deploy Hook.
# Only used by:  python scripts/deploy.py --redeploy backend
RENDER_DEPLOY_HOOK_BACKEND=
