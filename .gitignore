# Python environments and caches
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Static-site build output for Render
dist/

# Local deploy settings (Render deploy hooks are secrets)
.env.deploy

# Operating system clutter
.DS_Store
Thumbs.db
desktop.ini

# Editor and temporary files
*.tmp
*.bak
*.orig
*.swp
~$*

# Saved copies of external pages and their assets
Facebook.html
Facebook_files/

# Node backend for the giving API
server/node_modules/
server/.env
server/package-lock.json

# Admin bot: local state and secrets never belong in the repository
.rpai-changes.json
.rpai-backup-*
*.before-markers

# The admin bot runs on the church computer, not on the website. Keeping
# the folder out also keeps its .env with the GitHub token, its 53MB
# cloudflared binary and its undo history out of a public repository.
admin-bot/

# editor settings and recovery copies, not part of the website
.vscode/

# screen recordings and videos are not website content
*.mp4

