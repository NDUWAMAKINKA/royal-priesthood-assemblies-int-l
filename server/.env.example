# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit the real .env file.
# Every value below is a placeholder. Put the real account details in
# server/.env, which is gitignored.
# The secret key must never reach the browser, the HTML, or this git repo.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# Paystack secret key (server side only, starts with sk_)
PAYSTACK_SECRET_KEY=sk_test_your_key_here

# Optional. Paystack signs webhooks with the secret key unless a separate
# webhook secret is configured in the dashboard. Do not guess this value.
PAYSTACK_WEBHOOK_SECRET=

# Currency your Paystack account is enabled to settle in.
PAYSTACK_CURRENCY=ZMW

# The provider-confirmed minor-unit exponent. ISO 4217 says ZMW has two
# decimal places, but some providers treat it as whole units. A wrong value
# causes a 100x over- or under-charge. Confirm with Paystack; 0 preserves the
# previous behavior. If omitted, the API warns and uses 0.
PAYSTACK_CURRENCY_EXPONENT=0

# Operators your account is actually enabled for. Do not add one until the
# provider confirms it works; an unsupported operator fails after the donor
# has already entered details.
PAYSTACK_OPERATORS=mtn,airtel

# Amount limits in major units (ZMW). Keep these within the provider limits.
PAYSTACK_MIN_AMOUNT=1
PAYSTACK_MAX_AMOUNT=1000000

# Supabase Postgres. Use the session-pooler connection string from
# Project Settings -> Database. The password is a secret; never commit it.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-eu-west-3.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_SSL=true

# Supabase project metadata. The Node API does not need these; they are here
# for a future browser client. Never put the service_role/secret key in the
# website. The publishable key is safe to expose in a browser.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Where the browser site is served from. Used for CORS. Comma-separated.
ALLOWED_ORIGIN=http://127.0.0.1:8123,https://nduwamakinka.github.io,https://royalpriesthoodassembliesinternational.org
PUBLIC_SITE_URL=http://127.0.0.1:8123

# Bank transfer details shown by the fallback card. Leave these as
# "To be confirmed" until the church has verified them; the API refuses to
# publish a half-filled bank card.
BANK_NAME=To be confirmed
BANK_ACCOUNT_NAME=To be confirmed
BANK_ACCOUNT_NUMBER=To be confirmed
BANK_SWIFT=To be confirmed
BANK_BRANCH=To be confirmed
BANK_ADDRESS=To be confirmed

# ---------------------------------------------------------------------------
# Online meeting (video conference)
# ---------------------------------------------------------------------------
# The pastor opens /admin on the API host and signs in with this password.
# Use a long, unique passphrase. It is never sent to the browser on its own.
CONFERENCE_ADMIN_PASSWORD=replace_with_a_long_unique_passphrase

# Signs the 8-hour admin token. Generate a separate random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONFERENCE_ADMIN_SECRET=replace_with_a_random_hex_string
CONFERENCE_ADMIN_TOKEN_HOURS=8

# ---------------------------------------------------------------------------
# Email delivery for the meeting link
# ---------------------------------------------------------------------------
# Choose ONE transport.
#
# Option A: Resend (recommended on Render). Verify the church domain first, or
# use Resend's onboarding sender for a first test. MAIL_FROM must be a sender
# the provider allows.
RESEND_API_KEY=
MAIL_FROM=Royal Priesthood Assemblies International <royalpriesthoodassembliesintl@gmail.com>
MAIL_REPLY_TO=royalpriesthoodassembliesintl@gmail.com

# Option B: SMTP (for example Gmail with a 16-character App Password).
# Gmail requires 2-Step Verification and an App Password, never the normal
# account password. host=smtp.gmail.com, port=465, secure=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
